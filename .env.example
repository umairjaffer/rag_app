# Copy this file to ".env" and fill in your own values.
# Never commit a real .env file with real keys to version control.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini

# --- Embedding provider -----------------------------------------------------
# "huggingface" = free, runs locally, 384-dimensional vectors
# "openai"      = paid, cloud API, 1536-dimensional vectors
EMBEDDING_PROVIDER=huggingface

# --- Qdrant Cloud -----------------------------------------------------------
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io
QDRANT_COLLECTION=rag_documents

# --- Retrieval ---------------------------------------------------------
RETRIEVER_K=5

# --- File upload -----------------------------------------------------------
UPLOAD_DIR=upload_tmp
MAX_UPLOAD_SIZE_MB=50


# DATABASE
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@localhost:5432/rag_app